{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["target_id", "lead_id", "slot_type", "question", "experiment", "construction_checks", "first_interview", "confirmation_challenge", "reviewed_at"],
  "properties": {
    "target_id": {"type": "string", "pattern": "^target-[a-z0-9-]+$"},
    "lead_id": {"type": "string", "pattern": "^lead-[a-z0-9-]+$"},
    "slot_type": {"enum": ["data-first", "contradiction-first", "boundary-replication-first"]},
    "question": {"type": "string", "minLength": 25},
    "experiment": {
      "type": "object", "additionalProperties": false,
      "required": ["system", "unit", "contrast", "outcome", "dataset", "baseline", "falsifier", "positive_value", "null_value", "contrary_value", "independent_check"],
      "properties": {
        "system": {"type": "string"}, "unit": {"type": "string"}, "contrast": {"type": "string"}, "outcome": {"type": "string"},
        "dataset": {"type": "string"}, "baseline": {"type": "string"}, "falsifier": {"type": "string"},
        "positive_value": {"type": "string"}, "null_value": {"type": "string"}, "contrary_value": {"type": "string"}, "independent_check": {"type": "string"}
      }
    },
    "construction_checks": {
      "type": "object", "additionalProperties": false,
      "required": ["prior_art_distance", "actual_data_fit", "nontrivial_consequence", "decisive_test", "bounded_expertise"],
      "properties": {
        "prior_art_distance": {"$ref": "#/$defs/check"}, "actual_data_fit": {"$ref": "#/$defs/check"},
        "nontrivial_consequence": {"$ref": "#/$defs/check"}, "decisive_test": {"$ref": "#/$defs/check"}, "bounded_expertise": {"$ref": "#/$defs/check"}
      }
    },
    "first_interview": {
      "type": "object", "additionalProperties": false,
      "required": ["terminology", "exact_and_adjacent_search", "citation_trace", "dataset_audit", "strongest_simple_explanation", "specialist_objection", "rewrite", "verdict", "strongest_unresolved_risk"],
      "properties": {
        "terminology": {"type": "array", "minItems": 5, "items": {"type": "string"}},
        "exact_and_adjacent_search": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/evidence"}},
        "citation_trace": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/evidence"}},
        "dataset_audit": {"$ref": "#/$defs/dataset_audit"},
        "strongest_simple_explanation": {"type": "string", "minLength": 20},
        "specialist_objection": {"type": "string", "minLength": 20},
        "rewrite": {"type": ["string", "null"]},
        "verdict": {"enum": ["killed", "admitted"]},
        "strongest_unresolved_risk": {"type": "string", "minLength": 20}
      }
    },
    "confirmation_challenge": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_for_novelty", "evidence_against_novelty", "evidence_for_importance", "evidence_against_importance", "simpler_explanations", "decisive_tests", "confounders", "measurement_limits", "missing_expertise", "failed_searches", "disposition", "disposition_rationale", "surviving_question", "confidence"],
      "properties": {
        "evidence_for_novelty": {"$ref": "#/$defs/string_list"}, "evidence_against_novelty": {"$ref": "#/$defs/string_list"},
        "evidence_for_importance": {"$ref": "#/$defs/string_list"}, "evidence_against_importance": {"$ref": "#/$defs/string_list"},
        "simpler_explanations": {"$ref": "#/$defs/string_list"}, "decisive_tests": {"$ref": "#/$defs/string_list"},
        "confounders": {"$ref": "#/$defs/string_list"}, "measurement_limits": {"$ref": "#/$defs/string_list"},
        "missing_expertise": {"$ref": "#/$defs/string_list"}, "failed_searches": {"type": "array", "items": {"type": "string"}},
        "disposition": {"enum": ["rejected", "reframed", "gated", "surviving"]},
        "disposition_rationale": {"type": "string", "minLength": 35}, "surviving_question": {"type": ["string", "null"]},
        "confidence": {"enum": ["low", "moderate", "high"]}
      }
    },
    "reviewed_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "check": {"type": "object", "additionalProperties": false, "required": ["status", "rationale", "evidence"], "properties": {"status": {"const": "pass"}, "rationale": {"type": "string", "minLength": 20}, "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["url", "source_type", "location", "finding"], "properties": {"url": {"type": "string", "format": "uri"}, "source_type": {"enum": ["primary-study", "official-dataset", "conference-abstract", "bibliographic-metadata", "methods-study"]}, "location": {"type": "string", "minLength": 3}, "finding": {"type": "string", "minLength": 15}}},
    "dataset_audit": {"type": "object", "additionalProperties": false, "required": ["url", "sample_location", "rows", "variables", "protocol", "unit", "contrast", "outcome", "controls", "independent_check", "missingness_and_limits", "suitability"], "properties": {"url": {"type": "string", "format": "uri"}, "sample_location": {"type": "string"}, "rows": {"type": "integer", "minimum": 1}, "variables": {"type": "array", "minItems": 3, "items": {"type": "string"}}, "protocol": {"type": "string", "minLength": 20}, "unit": {"type": "string"}, "contrast": {"type": "string"}, "outcome": {"type": "string"}, "controls": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "independent_check": {"type": "string"}, "missingness_and_limits": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "suitability": {"enum": ["suitable", "partial", "unsuitable"]}}},
    "string_list": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}}
  }
}
