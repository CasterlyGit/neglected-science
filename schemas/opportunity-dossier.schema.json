{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/neglected-science/opportunity-dossier.schema.json",
  "title": "Neglected Science opportunity dossier",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "question",
    "gap_types",
    "importance",
    "known",
    "unresolved",
    "public_evidence",
    "competing_hypotheses",
    "experiment",
    "falsification",
    "confounders",
    "evidence_against_novelty",
    "neglect_explanation",
    "scores",
    "uncertainties",
    "sources",
    "status"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "question": {"type": "string", "minLength": 20},
    "gap_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["explicit", "contradiction", "translation", "data-use"]}
    },
    "importance": {"type": "string", "minLength": 1},
    "known": {"type": "string", "minLength": 1},
    "unresolved": {"type": "string", "minLength": 1},
    "public_evidence": {"type": "array", "items": {"type": "string"}},
    "competing_hypotheses": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "experiment": {"type": "string", "minLength": 1},
    "falsification": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "confounders": {"type": "array", "items": {"type": "string"}},
    "evidence_against_novelty": {"type": "array", "items": {"type": "string"}},
    "neglect_explanation": {"type": "string", "minLength": 1},
    "scores": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 4}
    },
    "uncertainties": {"type": "array", "items": {"type": "string"}},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "location"],
        "properties": {
          "source_id": {"type": "string"},
          "location": {"type": "string"}
        }
      }
    },
    "status": {"enum": ["candidate", "challenging", "rejected", "reframed", "gated", "finalist", "selected"]}
  }
}
