{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","required":["benchmark_id","record_count","blinded","criteria","target_pass_rate","status"],"properties":{"benchmark_id":{"type":"string","pattern":"^system-one-quality-"},"record_count":{"const":10},"blinded":{"const":true},"criteria":{"type":"array","minItems":9,"items":{"type":"string","minLength":12}},"target_pass_rate":{"type":"object","additionalProperties":false,"required":["minimum","maximum"],"properties":{"minimum":{"const":0.8},"maximum":{"const":0.9}}},"status":{"enum":["predeclared-not-run","evaluated"]},"pass_rate":{"type":"number","minimum":0,"maximum":1},"quality_verdict":{"enum":["within-target","leniency-audit-required","process-improvement-required"]},"selection_verdict":{"enum":["no-justified-trio","full-audit-trio-required"]}},"allOf":[{"if":{"properties":{"status":{"const":"evaluated"}}},"then":{"required":["pass_rate","quality_verdict","selection_verdict"]}}]}
