{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["audit_id", "finalist_ids", "dataset", "documentation_url", "documentation_location", "variables", "protocol", "required_measurements", "suitability", "fatal_gaps", "quality_controls", "uncertainties", "audited_at"],
  "properties": {
    "audit_id": {"type": "string", "pattern": "^da-[a-z0-9-]+$"},
    "finalist_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "dataset": {"type": "string", "minLength": 5},
    "documentation_url": {"type": "string", "format": "uri"},
    "documentation_location": {"type": "string", "minLength": 5},
    "variables": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "protocol": {"type": "string", "minLength": 10},
    "required_measurements": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "suitability": {"enum": ["suitable", "partial", "unsuitable", "unverified"]},
    "fatal_gaps": {"type": "array", "items": {"type": "string"}},
    "quality_controls": {"type": "array", "items": {"type": "string"}},
    "uncertainties": {"type": "array", "items": {"type": "string"}},
    "audited_at": {"type": "string", "format": "date-time"}
  }
}
