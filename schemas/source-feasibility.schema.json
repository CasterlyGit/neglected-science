{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["intake_id", "provider", "record_url", "record_title", "files", "retrieval", "disposition"],
  "properties": {
    "intake_id": {"type": "string", "pattern": "^intake-[a-z0-9-]+$"},
    "provider": {"const": "zenodo"},
    "record_url": {"type": "string", "format": "uri"},
    "record_title": {"type": "string", "minLength": 20},
    "files": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "source_checksum", "retrieved_checksum", "checksum_match", "structural_note"], "properties": {"name": {"type": "string", "minLength": 3}, "source_checksum": {"type": "string", "pattern": "^md5:[a-f0-9]{32}$"}, "retrieved_checksum": {"type": "string", "pattern": "^md5:[a-f0-9]{32}$"}, "checksum_match": {"const": true}, "structural_note": {"type": "string", "minLength": 15}}}},
    "retrieval": {"type": "object", "additionalProperties": false, "required": ["method", "result"], "properties": {"method": {"type": "string", "minLength": 10}, "result": {"const": "checksum-verified"}}},
    "disposition": {"type": "object", "additionalProperties": false, "required": ["verdict", "reason"], "properties": {"verdict": {"const": "eligible-for-cell-construction"}, "reason": {"type": "string", "minLength": 25}}}
  }
}
