{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fevkit.vercel.app/schema/run-0.1.json",
  "title": "FEVKit scientific trajectory",
  "type": "object",
  "required": ["spec_version", "run"],
  "additionalProperties": false,
  "properties": {
    "spec_version": {"const": "0.1"},
    "run": {
      "type": "object",
      "required": ["id", "title", "objective", "domain", "started_at", "completed_at", "status", "system", "privacy", "environment", "inputs", "artifacts", "steps", "evidence", "claims", "human_checkpoints", "validation", "replay"],
      "additionalProperties": true,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "objective": {"type": "string", "minLength": 1},
        "domain": {"type": "string", "minLength": 1},
        "started_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"},
        "status": {"enum": ["planned", "running", "completed", "failed", "cancelled"]},
        "system": {"type": "object", "required": ["name", "version"], "additionalProperties": true, "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}},
        "privacy": {"type": "object", "required": ["contains_personal_data"], "additionalProperties": true, "properties": {"contains_personal_data": {"type": "boolean"}}},
        "environment": {"type": "object", "required": ["runtimes"], "additionalProperties": true, "properties": {"runtimes": {"type": "object"}}},
        "inputs": {"type": "array", "items": {"$ref": "#/$defs/file"}},
        "artifacts": {"type": "array", "items": {"$ref": "#/$defs/file"}},
        "steps": {"type": "array", "items": {"$ref": "#/$defs/step"}},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
        "human_checkpoints": {"type": "array", "items": {"type": "object"}},
        "validation": {"type": "object", "required": ["profile", "claimed_stage", "evaluations"], "additionalProperties": true, "properties": {"profile": {"type": "string"}, "claimed_stage": {"enum": ["V0", "V1", "V2", "V3", "V4"]}, "evaluations": {"type": "array"}}},
        "replay": {"type": "object", "required": ["command", "expected_artifacts"], "additionalProperties": true}
      }
    }
  },
  "$defs": {
    "file": {"type": "object", "required": ["id", "path", "sha256"], "additionalProperties": true, "properties": {"id": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "step": {"type": "object", "required": ["id", "sequence", "function", "action", "status", "inputs", "outputs"], "additionalProperties": true, "properties": {"id": {"type": "string", "minLength": 1}, "sequence": {"type": "integer", "minimum": 1}, "function": {"enum": ["F1", "F2", "F3", "F4", "F5", "F6"]}, "action": {"type": "string", "minLength": 1}, "status": {"type": "string"}, "inputs": {"type": "array", "items": {"type": "string"}}, "outputs": {"type": "array", "items": {"type": "string"}}}},
    "evidence": {"type": "object", "required": ["id", "class", "artifact_ids", "retrieved_at", "source"], "additionalProperties": true, "properties": {"id": {"type": "string", "minLength": 1}, "class": {"enum": ["E1", "E2", "E3", "E4", "E5", "E6"]}, "artifact_ids": {"type": "array", "items": {"type": "string"}}, "retrieved_at": {"type": "string"}, "source": {"type": "object"}}},
    "claim": {"type": "object", "required": ["id", "text", "kind", "risk", "step_ids", "support"], "additionalProperties": true, "properties": {"id": {"type": "string", "minLength": 1}, "text": {"type": "string", "minLength": 1}, "kind": {"enum": ["retrieved_fact", "observation", "calculation", "inference", "causal_hypothesis", "speculation"]}, "risk": {"enum": ["low", "research", "high", "clinical"]}, "step_ids": {"type": "array", "items": {"type": "string"}}, "support": {"type": "array", "items": {"type": "object", "required": ["evidence_id", "relation"]}}}}
  }
}
